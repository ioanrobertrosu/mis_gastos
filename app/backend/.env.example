NODE_ENV=development
PORT=3000

# Supabase PostgreSQL
# Transaction pooler (runtime de Prisma)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa / session pooler (migraciones)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth
SUPABASE_JWT_SECRET=
JWT_ISSUER="https://<project-ref>.supabase.co/auth/v1"
JWT_AUDIENCE=authenticated
# API de administración de Auth (borrado de cuentas). Clave secreta (sb_secret_… o service_role):
# solo en el backend, nunca en el cliente.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=

# CORS (solo afecta al cliente web): orígenes separados por comas
CORS_ORIGINS=http://localhost:8081

# Número de proxies inversos delante del backend (0 si no hay ninguno). Hay que ajustarlo al
# desplegar: de él depende la IP real de cada cliente, y con ella el límite de peticiones.
TRUST_PROXY=0

# BD de test: por defecto, la local de docker-compose.test.yml (no hace falta configurar nada).
# Para usar otra (se VACÍA en cada test), descomenta las dos variables:
# TEST_DATABASE_URL="postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# TEST_DIRECT_URL="postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
