// Las URLs de conexión se definen en prisma.config.ts (Prisma 7):
// DIRECT_URL para migraciones y DATABASE_URL para el cliente en runtime.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explícito: si no, Prisma lo infiere del tsconfig, que no existe aún en la etapa `deps` de Docker.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Sin @default: se asigna explícitamente con el `sub` del JWT de Supabase.
  id          String   @id
  email       String   @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())

  identities Identity[]
}

// Proveedor de login vinculado (Google, Apple…). Registro informativo: User.id ya es el `sub`.
model Identity {
  id         String   @id @default(uuid())
  userId     String
  provider   String // p. ej. "google", "apple", "email"
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}
