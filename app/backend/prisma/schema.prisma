// Las URLs de conexión se definen en prisma.config.ts (Prisma 7):
// DIRECT_URL para migraciones y DATABASE_URL para el cliente en runtime.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explícito: si no, Prisma lo infiere del tsconfig, que no existe aún en la etapa `deps` de Docker.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  LIMITED_EDITOR
  VIEWER
}

enum Currency {
  EUR
  USD
  JPY
  CNY
  INR
  GBP
}

model User {
  // Sin @default: se asigna explícitamente con el `sub` del JWT de Supabase.
  id          String    @id
  email       String    @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  // Soft delete: la fila se conserva anonimizada para no romper el historial de sus movimientos.
  deletedAt   DateTime?

  identities         Identity[]
  memberships        BudgetMember[]
  invitationsCreated OneTimeInvite[]
  transactions       Transaction[]
  contributions      GoalContribution[]
}

// Proveedor de login vinculado (Google, Apple…). Registro informativo: User.id ya es el `sub`.
model Identity {
  id         String   @id @default(uuid())
  userId     String
  provider   String // p. ej. "google", "apple", "email"
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model Budget {
  id        String   @id @default(uuid())
  name      String
  currency  Currency @default(EUR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      BudgetMember[]
  invitations  OneTimeInvite[]
  categories   Category[]
  transactions Transaction[]
  goals        Goal[]
}

model Category {
  id           String   @id @default(uuid())
  budgetId     String
  name         String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  icon         String   @default("folder")
  colorHex     String   @default("#64748B")
  // Soft delete: las transacciones de una categoría desactivada se conservan.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([budgetId])
}

/// Gasto en una categoría (modelo base cero: solo gastos; el asignado son los límites).
model Transaction {
  id          String   @id @default(uuid())
  // Redundante con la categoría (que nunca cambia de presupuesto): permite listar y agregar
  // por presupuesto sin join.
  budgetId    String
  categoryId  String
  // Autor; los usuarios borrados se conservan anonimizados, así que la referencia se mantiene.
  createdById String?
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  date        DateTime @db.Date
  // Solo marca informativa: las recurrentes se registran a mano cada mes.
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([budgetId, date(sort: Desc), id(sort: Desc)])
  @@index([categoryId, date])
}

model BudgetMember {
  id       String   @id @default(uuid())
  userId   String
  budgetId String
  role     Role     @default(LIMITED_EDITOR)
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([userId, budgetId])
  @@index([budgetId])
}

model OneTimeInvite {
  id          String   @id @default(uuid())
  budgetId    String
  createdById String
  token       String   @unique @default(uuid())
  role        Role     @default(LIMITED_EDITOR)
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([createdById])
}

enum GoalStatus {
  IN_PROGRESS
  REACHED
  ARCHIVED
}

/// Meta de ahorro del presupuesto. `currentAmount` es la suma de sus contribuciones.
model Goal {
  id            String     @id @default(uuid())
  budgetId      String
  title         String
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  deadline      DateTime?  @db.Date
  status        GoalStatus @default(IN_PROGRESS)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  budget        Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([budgetId])
}

model GoalContribution {
  id        String   @id @default(uuid())
  goalId    String
  // Autor; los usuarios borrados se conservan anonimizados, así que la referencia se mantiene.
  userId    String?
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  goal Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt(sort: Desc)])
}
