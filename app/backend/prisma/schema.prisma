// Las URLs de conexión se definen en prisma.config.ts (Prisma 7):
// DIRECT_URL para migraciones y DATABASE_URL para el cliente en runtime.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explícito: si no, Prisma lo infiere del tsconfig, que no existe aún en la etapa `deps` de Docker.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  LIMITED_EDITOR
  VIEWER
}

enum Currency {
  EUR
  USD
  JPY
  CNY
  INR
  GBP
}

model User {
  // Sin @default: se asigna explícitamente con el `sub` del JWT de Supabase.
  id          String   @id
  email       String   @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())

  identities         Identity[]
  memberships        BudgetMember[]
  invitationsCreated OneTimeInvite[]
}

// Proveedor de login vinculado (Google, Apple…). Registro informativo: User.id ya es el `sub`.
model Identity {
  id         String   @id @default(uuid())
  userId     String
  provider   String // p. ej. "google", "apple", "email"
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model Budget {
  id        String   @id @default(uuid())
  name      String
  currency  Currency @default(EUR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     BudgetMember[]
  invitations OneTimeInvite[]
}

model BudgetMember {
  id       String   @id @default(uuid())
  userId   String
  budgetId String
  role     Role     @default(LIMITED_EDITOR)
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([userId, budgetId])
  @@index([budgetId])
}

model OneTimeInvite {
  id          String   @id @default(uuid())
  budgetId    String
  createdById String
  token       String   @unique @default(uuid())
  role        Role     @default(LIMITED_EDITOR)
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([createdById])
}
