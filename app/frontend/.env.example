# Variables de la app (Expo). Solo EXPO_PUBLIC_*: se incrustan en la app y son públicas por diseño.
# Nunca un secreto aquí (ni el secreto del cliente OAuth Web ni la clave secreta de Supabase).

# Proyecto Supabase (Auth): Project Settings → API Keys → Publishable key (sb_publishable_…).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API del backend. En desarrollo, el local (BD de desarrollo): http://localhost:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth: IDs de cliente de Google Cloud (el secreto del cliente Web se configura en Supabase).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
